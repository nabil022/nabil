const COUNT := 50

static func get_by_id(id: String) -> Dictionary:
	for f in ALL:
		if f["id"] == id:
			return f
	return {}


static func index_of(id: String) -> int:
	for i in ALL.size():
		if ALL[i]["id"] == id:
			return i
	return -1


static func ids() -> Array[String]:
	var out: Array[String] = []
	for f in ALL:
		out.append(f["id"])
	return out


static func of_tier(tier: int) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for f in ALL:
		if f["tier"] == tier:
			out.append(f)
	return out


static func of_set(set_id: String) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for f in ALL:
		if f["set_id"] == set_id:
			out.append(f)
	return out


static func set_ids() -> Array[String]:
	var out: Array[String] = []
	for f in ALL:
		if not out.has(f["set_id"]):
			out.append(f["set_id"])
	out.sort()
	return out
