shader_type canvas_item;
render_mode blend_mix, unshaded;

// Procedural Fragment sigil (spec 2.3).
//
// Every visual in this game is generated by code -- there are no sprite sheets
// and no imported art. One shader draws all 50 sigils; `sigil_seed` picks which.
//
// The seed drives a xorshift32 stream that is mirrored exactly in
// tools/fragment_gen.py, so seed selection can be verified numerically (no two
// Fragments get near-identical silhouettes) rather than only by eye.
//
//   Silhouette : r(theta) = 1 + a*sin(n*theta + phi) + b*sin(m*theta + psi)
//   Structure  : 2-5 concentric rings, or the same count of radial spokes
//   Palette    : hue from the seed, clamped into the tier's band; saturation
//                and value fixed per tier, so rarity reads at a glance
//   Motion     : slow rotation; tiers 4-5 add a pulsing glow and orbiting motes

uniform float sigil_seed = 8841923.0;

// Tier presentation, passed in from Balance so data/balance.gd stays the single
// source of truth for the numbers.
uniform float tier_hue_lo = 0.55;
uniform float tier_hue_hi = 0.62;
uniform float tier_saturation = 0.5;
uniform float tier_value = 0.9;
uniform float tier_glow = 0.0;
uniform float orbit_count = 0.0;

// 1.0 renders the locked silhouette: the outline only, no inner structure and
// no colour, so an unowned slot hints at the shape without revealing it.
uniform float locked = 0.0;
uniform float locked_brightness : hint_range(0.0, 1.0) = 0.17;

uniform float scale : hint_range(0.2, 1.0) = 0.30;
uniform float spin_speed = 0.08;
uniform float alpha : hint_range(0.0, 1.0) = 1.0;
// Cosmetic frame ring (spec 6.4); 0.0 draws nothing.
uniform float frame_style = 0.0;
uniform vec3 frame_color = vec3(1.0);

const float TAU_ = 6.28318530718;

uint _xorshift(uint h) {
	h ^= h << 13u;
	h ^= h >> 17u;
	h ^= h << 5u;
	return h;
}

// Mirror of SeedStream.next() in tools/fragment_gen.py. Keep the two in step.
float rnd(inout uint h) {
	h = _xorshift(h);
	return float(h & 0xFFFFFFu) / 16777216.0;
}

vec3 hsv_to_rgb(vec3 c) {
	vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
	vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
	return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void fragment() {
	uint h = uint(sigil_seed);
	float n = 3.0 + floor(rnd(h) * 5.0);
	float m = 2.0 + floor(rnd(h) * 6.0);
	float amp_a = 0.10 + rnd(h) * 0.22;
	float amp_b = 0.04 + rnd(h) * 0.16;
	float phi = rnd(h) * TAU_;
	float psi = rnd(h) * TAU_;
	float rings = 2.0 + floor(rnd(h) * 4.0);
	float spokes = rnd(h) > 0.5 ? 1.0 : 0.0;
	float hue_t = rnd(h);
	float spin = rnd(h);
	if (m == n) {
		m = 2.0 + mod(m - 1.0, 6.0);
	}

	vec2 p = UV - vec2(0.5);
	float dist = length(p);
	float ang = atan(p.y, p.x);

	// Slow rotation, direction and rate varying by seed.
	float dir = spin > 0.5 ? 1.0 : -1.0;
	ang += TIME * spin_speed * dir * (0.6 + spin * 0.8);

	// Silhouette.
	float shape_r = 1.0 + amp_a * sin(n * ang + phi) + amp_b * sin(m * ang + psi);
	float edge = shape_r * scale;
	// One-pixel-ish feather, so the outline stays crisp at any size.
	float aa = fwidth(dist) * 1.5 + 0.0015;
	float inside = 1.0 - smoothstep(edge - aa, edge + aa, dist);
	float rim = smoothstep(edge - 0.035, edge - aa, dist) * inside;

	float pulse = 0.5 + 0.5 * sin(TIME * 1.6 + phi);

	vec3 col = vec3(0.0);
	float a = 0.0;

	if (locked > 0.5) {
		// Locked slot: filled silhouette plus a slightly brighter rim. No inner
		// structure and no hue -- shape only (spec 6.1).
		float body = inside * locked_brightness;
		float outline = rim * (locked_brightness * 2.4);
		col = vec3(0.42, 0.48, 0.62) * (body + outline);
		a = clamp(body + outline, 0.0, 1.0);
	} else {
		float hue = mix(tier_hue_lo, tier_hue_hi, hue_t);
		vec3 core = hsv_to_rgb(vec3(hue, tier_saturation * 0.55, min(1.0, tier_value + 0.12)));
		vec3 body_col = hsv_to_rgb(vec3(hue, tier_saturation, tier_value));
		vec3 rim_col = hsv_to_rgb(vec3(fract(hue + 0.02), tier_saturation * 0.75, 1.0));

		// Inner structure: concentric rings, or the same count of radial spokes.
		float t_norm = clamp(dist / max(edge, 0.0001), 0.0, 1.0);
		float structure;
		if (spokes > 0.5) {
			float s = abs(sin(ang * rings + phi * 0.5));
			structure = smoothstep(0.86, 1.0, s) * smoothstep(0.14, 0.55, t_norm);
		} else {
			float band = abs(sin(t_norm * rings * 3.14159 + psi * 0.25));
			structure = smoothstep(0.88, 1.0, band);
		}
		structure *= inside;

		// Bright core.
		float core_mask = 1.0 - smoothstep(0.0, 0.30, t_norm);

		col = body_col * inside * 0.34;
		col += body_col * structure * 0.85;
		col += rim_col * rim * (0.9 + tier_glow * 0.6 * pulse);
		col += core * core_mask * inside * (0.45 + tier_glow * 0.55 * pulse);

		a = clamp(inside * 0.44 + structure * 0.9 + rim + core_mask * inside * 0.7, 0.0, 1.0);

		// Tiers 4-5: an outer glow that breathes, and motes orbiting the sigil.
		if (tier_glow > 0.001) {
			float halo = exp(-pow(max(dist - edge, 0.0) * 9.0, 2.0));
			col += rim_col * halo * tier_glow * (0.28 + 0.22 * pulse);
			a = max(a, halo * tier_glow * (0.30 + 0.25 * pulse));
		}
		if (orbit_count > 0.5) {
			float orbit_r = edge + 0.055;
			for (int i = 0; i < 12; i++) {
				if (float(i) >= orbit_count) {
					break;
				}
				float fi = float(i) / orbit_count;
				float oa = TIME * (0.35 + spin * 0.25) * dir + fi * TAU_;
				vec2 op = vec2(cos(oa), sin(oa)) * orbit_r;
				float d = length(p - op);
				float mote = exp(-pow(d * 90.0, 2.0));
				col += rim_col * mote * (0.7 + 0.3 * pulse);
				a = max(a, mote);
			}
		}

		// Cosmetic frame ring (Prism purchase; purely decorative).
		if (frame_style > 0.5) {
			float ring_r = 0.455;
			float ring = smoothstep(0.012, 0.0, abs(dist - ring_r));
			if (frame_style > 1.5) {
				// Style 2: dashed ring.
				ring *= step(0.5, fract(ang / TAU_ * 24.0 + TIME * 0.05));
			}
			col += frame_color * ring * 0.85;
			a = max(a, ring * 0.85);
		}
	}

	COLOR = vec4(col, clamp(a, 0.0, 1.0) * alpha);
}
